# Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Frontend Configuration
# ------------------------------------------------------------------------------
# In Local Development: Use http://localhost:3001
# In AWS Production: Replace with your Amazon API Gateway HTTP API endpoint
# (e.g., https://xyz123.execute-api.us-east-1.amazonaws.com)
VITE_API_URL=http://localhost:3001

# ------------------------------------------------------------------------------
# 2. AWS Backend & Database Configuration (Amazon RDS PostgreSQL)
# ------------------------------------------------------------------------------
# Leave DB_HOST blank or commented to use automatic zero-config embedded database!
# To connect to Amazon RDS PostgreSQL, uncomment and fill in:
# DB_HOST=uptime-tracker-db-prod.c7xyz.us-east-1.rds.amazonaws.com
# DB_PORT=5432
# DB_NAME=uptime_db
# DB_USER=postgresadmin
# DB_PASSWORD=UptimeTracker2026Secure!
# DB_SSL=true

# ------------------------------------------------------------------------------
# 3. AWS Cloud Monitoring & Alerting
# ------------------------------------------------------------------------------
AWS_REGION=us-east-1
# AWS_SNS_TOPIC_ARN=arn:aws:sns:us-east-1:123456789012:WebsiteUptimeAlertsTopic
# S3_REPORTS_BUCKET=website-uptime-tracker-reports-prod
